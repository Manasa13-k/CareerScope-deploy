# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Atlas or Local)
# MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/careerscope
# Local MongoDB example: mongodb://localhost:27017/careerscope
MONGODB_URI=mongodb://localhost:27017/careerscope

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
